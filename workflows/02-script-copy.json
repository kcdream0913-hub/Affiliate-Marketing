{
  "name": "02 Script Copy + Compliance Gate",
  "nodes": [
    {
      "parameters": {},
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/offers?status=eq.approved&order=rubric_score.desc&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {}
      },
      "name": "Top Approved Offer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpCustomAuth": {
          "name": "Supabase Service Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model: 'google/gemini-2.5-flash-lite', messages: [{role:'system', content:'Write a 21-34s vertical video script for the offer. Structure: Hook (pick randomly: curiosity-gap | direct-address | correction | demonstration) -> Problem -> Solution -> CTA (CTA must say link in bio, never a URL). Also produce caption (MUST start with #ad, no links, 3-5 hashtags) and on-screen text lines. STRICT BANS: no disease/cure claims, no income/$ figures, no before/after, no guaranteed, no clinically proven. Sell mechanism + experience, not outcomes. Output JSON {script, caption, onscreen_lines, hook_type}.'}, {role:'user', content: JSON.stringify({offer: $json, angle: $('When Called').first().json.theme || 'general'})}]}) }}",
        "options": {}
      },
      "name": "LLM Write Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "OpenRouter Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const content = $json.choices?.[0]?.message?.content ?? '{}';\nlet draft;\ntry { draft = JSON.parse(content.replace(/^```json?|```$/g, '').trim()); } catch (e) { throw new Error('LLM returned non-JSON script'); }\nif (!draft.caption?.trim().startsWith('#ad')) { draft.caption = '#ad ' + (draft.caption || ''); }\nreturn [{ json: { ...draft, offer_category: $('Top Approved Offer').first().json.category || '' } }];"
      },
      "name": "Normalize Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://attribution:8080/compliance/check",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "name": "Compliance Gate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.blocked }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Passed Gate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/videos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({offer_id: $('Top Approved Offer').first().json.id, script: $('Normalize Draft').first().json.script, caption: $('Normalize Draft').first().json.caption, hook_type: $('Normalize Draft').first().json.hook_type, ftc_disclosed: true, status: 'draft'}) }}",
        "options": {}
      },
      "name": "Save Draft Video Row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -100
      ],
      "credentials": {
        "httpCustomAuth": {
          "name": "Supabase Service Auth"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🚫 COMPLIANCE BLOCK (HIGH)\nRules: {{ $('Compliance Gate').first().json.matched_rules }}\nScript draft halted before any asset spend. Human review required.",
        "additionalFields": {}
      },
      "name": "Alert HIGH Block",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1320,
        140
      ],
      "credentials": {
        "telegramApi": {
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "When Called": {
      "main": [
        [
          {
            "node": "Top Approved Offer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Top Approved Offer": {
      "main": [
        [
          {
            "node": "LLM Write Script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "LLM Write Script": {
      "main": [
        [
          {
            "node": "Normalize Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Draft": {
      "main": [
        [
          {
            "node": "Compliance Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compliance Gate": {
      "main": [
        [
          {
            "node": "Passed Gate?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Passed Gate?": {
      "main": [
        [
          {
            "node": "Save Draft Video Row",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert HIGH Block",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  }
}
