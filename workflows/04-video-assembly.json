{
  "name": "04 Video Assembly (FFmpeg + edge-tts)",
  "nodes": [
    {
      "parameters": {},
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Variation logic: rotate voice per run (anti-fingerprinting guardrail).\nconst voices = ['en-US-JennyNeural', 'en-US-GuyNeural', 'en-US-AriaNeural', 'en-GB-SoniaNeural', 'en-AU-NatashaNeural'];\nconst voice = voices[Math.floor(Math.random() * voices.length)];\nreturn [{ json: { ...$json, voice } }];"
      },
      "name": "Pick Voice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "command": "=mkdir -p /data/media/{{ $json.video_id }} && printf '%s' '{{ ($json.script || \"\").replace(/'/g, \"'\\\\''\") }}' > /data/media/{{ $json.video_id }}/script.txt"
      },
      "name": "Write Script File",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "command": "=cd /app && bash scripts/video_assembly.sh /data/media/{{ $json.video_id }} /data/media/{{ $json.video_id }}/script.txt {{ $json.voice }} /data/media/{{ $json.video_id }}/final.mp4"
      },
      "name": "Assemble Video",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/videos?id=eq.{{ $json.video_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ai_labeled: true, c2pa_present: true, status: 'approved'}) }}",
        "options": {}
      },
      "name": "Mark Assembled",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "httpCustomAuth": {
          "name": "Supabase Service Auth"
        }
      }
    }
  ],
  "connections": {
    "When Called": {
      "main": [
        [
          {
            "node": "Pick Voice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick Voice": {
      "main": [
        [
          {
            "node": "Write Script File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write Script File": {
      "main": [
        [
          {
            "node": "Assemble Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assemble Video": {
      "main": [
        [
          {
            "node": "Mark Assembled",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  }
}
