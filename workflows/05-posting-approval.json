{
  "name": "05 Posting with Human Approval",
  "nodes": [
    {
      "parameters": {},
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Account-warming guardrail: max 3 posts/day, 2-4h spacing (first 2-3 weeks: 1-3/day).\nconst now = new Date();\nconst posted = $json.posted_today || 0;\nconst lastPostAt = $json.last_post_at ? new Date($json.last_post_at) : null;\nconst hoursSince = lastPostAt ? (now - lastPostAt) / 3.6e6 : 99;\nif (posted >= 3) throw new Error('WARMING CAP: 3 posts today already');\nif (hoursSince < 2) throw new Error(`WARMING SPACING: only ${hoursSince.toFixed(1)}h since last post (need >=2h)`);\nreturn [{ json: $json }];"
      },
      "name": "Warming Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "message": "=📹 APPROVAL NEEDED (HUMAN-CHECKPOINT)\nOffer: {{ $json.offer_name }}\nHook: {{ $json.hook_type }}\nCaption: {{ $json.caption }}\nVideo: /data/media/{{ $json.video_id }}/final.mp4\nCompliance: PASSED ({{ $json.verdict }})\nAI-label + #ad burned in. Approve to post?",
        "responseType": "approval",
        "options": {
          "limitWaitTime": {
            "resumeAmount": 12,
            "resumeUnit": "hours"
          }
        }
      },
      "name": "Telegram Approval",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "telegramApi": {
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data?.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.upload-post.com/api/upload",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "contentType": "multipart-form-data",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "title",
              "value": "={{ $('When Called').first().json.caption }}"
            },
            {
              "name": "platform[]",
              "value": "tiktok"
            },
            {
              "name": "platform[]",
              "value": "instagram"
            },
            {
              "name": "is_ai_generated",
              "value": "true"
            },
            {
              "name": "video",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "video"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "name": "Post via Upload-Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Upload-Post Header Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/videos?id=eq.{{ $('When Called').first().json.video_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({status: 'posted', posted_at: new Date().toISOString()}) }}",
        "options": {}
      },
      "name": "Mark Posted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -100
      ],
      "credentials": {
        "httpCustomAuth": {
          "name": "Supabase Service Auth"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=❌ Rejected — video {{ $('When Called').first().json.video_id }} stays in draft queue.",
        "additionalFields": {}
      },
      "name": "Log Rejection",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        140
      ],
      "credentials": {
        "telegramApi": {
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "When Called": {
      "main": [
        [
          {
            "node": "Warming Guard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Warming Guard": {
      "main": [
        [
          {
            "node": "Telegram Approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram Approval": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Post via Upload-Post",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Rejection",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post via Upload-Post": {
      "main": [
        [
          {
            "node": "Mark Posted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  }
}
