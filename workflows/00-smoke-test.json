{
  "name": "00 Smoke Test",
  "nodes": [
    {
      "parameters": {},
      "name": "Run Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model: 'google/gemini-2.5-flash-lite', messages: [{role:'user', content:'Reply with exactly two words: SMOKE OK'}]}) }}",
        "options": {}
      },
      "name": "Test OpenRouter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "credentials": { "httpHeaderAuth": { "name": "OpenRouter Header Auth" } }
    },
    {
      "parameters": {
        "command": "cd /app && echo '{\"script\":\"Make $10k/month while you sleep\",\"caption\":\"link in bio\"}' | python3 -m src.compliance.cli"
      },
      "name": "Test Compliance Gate",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [440, 0],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/offers?select=id&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": { "response": { "response": { "fullResponse": true } } }
      },
      "name": "Test Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "credentials": { "httpCustomAuth": { "name": "Supabase Service Auth" } }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=✅ SMOKE TEST\nOpenRouter: {{ $('Test OpenRouter').first().json.choices[0].message.content }}\nCompliance gate blocked HIGH creative: {{ JSON.parse($('Test Compliance Gate').first().json.stdout || '{}').blocked }}\nSupabase REST: HTTP {{ $('Test Supabase').first().json.statusCode }}\nTelegram: you are reading this.\nAll four integrations verified.",
        "additionalFields": {}
      },
      "name": "Report via Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 0],
      "credentials": { "telegramApi": { "name": "Telegram Bot" } }
    }
  ],
  "connections": {
    "Run Manually": { "main": [[{ "node": "Test OpenRouter", "type": "main", "index": 0 }]] },
    "Test OpenRouter": { "main": [[{ "node": "Test Compliance Gate", "type": "main", "index": 0 }]] },
    "Test Compliance Gate": { "main": [[{ "node": "Test Supabase", "type": "main", "index": 0 }]] },
    "Test Supabase": { "main": [[{ "node": "Report via Telegram", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "UTC" }
}
