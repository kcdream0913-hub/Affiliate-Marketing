# Caddy auto-TLS for both hosts. DOMAIN comes from .env via compose.
n8n.{$DOMAIN} {
    reverse_proxy n8n:5678
}

go.{$DOMAIN} {
    # Only click + postback + health routes are public; /compliance and
    # /assemble are internal (n8n reaches them directly on the docker network).
    @public path /v/* /postback/* /health
    handle @public {
        reverse_proxy attribution:8080
    }
    handle {
        respond "not found" 404
    }
    header /v/* Cache-Control "no-store"
}
