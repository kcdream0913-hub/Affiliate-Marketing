# Copy to .env and fill in. HUMAN-CHECKPOINT: never commit the real .env.
DOMAIN=yourdomain.com
POSTGRES_PASSWORD=change-me-long-random
N8N_ENCRYPTION_KEY=change-me-32-chars-random

# Supabase (service role key — server-side only, never client)
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=service-role-key-here

# Attribution
IP_SALT=change-me-random-salt
DS24_IPN_PASSPHRASE=set-in-digistore24-ipn-settings
CB_INS_SECRET=set-in-clickbank-ins-settings
